<?xml version="1.0" encoding="utf-8"?>

<resources>

    <style name="Base.Theme.Fonehaus"
        parent="Theme.Material3.DayNight.NoActionBar">

        <!-- Main Fone Haus colour (Yellow) -->
        <item name="colorPrimary">@color/fone_yellow</item>

        <item name="colorPrimaryContainer">@color/fone_yellow_light</item>

        <!-- Clean White Background (#FFFFFF) -->
        <item name="android:windowBackground">@color/black_charcoal_hex</item>

        <!-- Primary text color on light background -->
        <item name="android:textColorPrimary">@color/text_primary</item>

        <!-- Material Button Style without stroke, 8dp corner radius -->
        <item name="materialButtonStyle">@style/Widget.Fonehaus.Button</item>

    </style>

    <style name="Widget.Fonehaus.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fone_yellow</item>
        <item name="android:textColor">@color/black</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Fonehaus"
        parent="Base.Theme.Fonehaus" />

</resources>
