<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black_charcoal_hex">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <!-- ==========================================
             FULL-SCREEN TECH SHOWCASE BACKGROUND IMAGE
             ========================================== -->

        <ImageView
            android:id="@+id/imgWelcomeBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:src="@drawable/welcome_bg_devices"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ==========================================
             LIGHT SHADOW OVERLAY (SCRIM)
             ========================================== -->

        <View
            android:id="@+id/vShadowScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_welcome_scrim"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ==========================================
             FOREGROUND WELCOME CARD
             ========================================== -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_welcome_card_glass"
            android:padding="24dp"
            android:layout_margin="@dimen/screen_padding"
            android:elevation="10dp"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- FONE HAUS OFFICIAL LOGO IMAGE -->

            <ImageView
                android:id="@+id/imgFoneHausLogo"
                android:layout_width="@dimen/welcome_logo_size"
                android:layout_height="@dimen/welcome_logo_size"
                android:src="@drawable/ic_fone_haus_logo"
                android:scaleType="fitCenter"
                android:contentDescription="Fone Haus Logo"
                android:layout_marginBottom="8dp" />

            <!-- WELCOME MESSAGE -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to Fone Haus"
                android:textSize="@dimen/subtitle_text_size"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Browse smartphones, laptops, audio gear, and TVs."
                android:textSize="@dimen/body_text_size"
                android:textColor="@color/text_secondary"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- QUICK CATEGORY CHIPS ROW (FEATURE) -->

            <HorizontalScrollView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipPhones"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📱 Phones"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/chip_text_size"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_category"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipLaptops"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💻 Laptops"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/chip_text_size"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_category"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipAudio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎧 Audio"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/chip_text_size"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_category"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/chipTVs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📺 Smart TVs"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/chip_text_size"
                        android:textStyle="bold"
                        android:background="@drawable/bg_chip_category"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                </LinearLayout>

            </HorizontalScrollView>

            <!-- VIEW PRODUCTS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="View Products"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- CATEGORIES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="Browse Categories"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- CART -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="Shopping Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
