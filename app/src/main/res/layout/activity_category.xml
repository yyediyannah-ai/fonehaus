<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black_charcoal_hex">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0.05"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fone Haus Categories"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:textColor="@color/fone_yellow"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- PHONES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📱 Smartphones &amp; iPhones"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- TABLETS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTablets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📱 Tablets"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- LAPTOPS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaptops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="💻 Laptops"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- AUDIO -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🎧 Audio &amp; Headphones"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- TVS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTVs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📺 Smart TVs"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- SMART WATCHES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="⌚ Smart Watches"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- ALL PRODUCTS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🛍️ All Products"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

            <!-- CART -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🛒 Shopping Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                app:backgroundTint="@color/fone_yellow_dark"
                app:strokeWidth="0dp"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
