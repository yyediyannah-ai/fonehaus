<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black_charcoal_hex">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fone Haus Categories"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:textColor="@color/fone_yellow_text"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <!-- SEARCH BOX CONTAINER -->

            <LinearLayout
                android:id="@+id/categorySearchBoxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_box"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 "
                    android:textSize="16sp"
                    android:importantForAccessibility="no" />

                <EditText
                    android:id="@+id/edtCategorySearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="@dimen/input_field_min_height"
                    android:hint="Search products, brands..."
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/text_primary"
                    android:textColorHint="#888888"
                    android:background="@null"
                    android:textSize="@dimen/body_text_size"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCategorySearch"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- PHONES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPhones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📱 Smartphones &amp; iPhones"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- TABLETS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTablets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📱 Tablets"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- LAPTOPS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLaptops"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="💻 Laptops"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- AUDIO -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🎧 Audio &amp; Headphones"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- TVS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTVs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="📺 Smart TVs"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- SMART WATCHES -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWatches"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="⌚ Smart Watches"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- ALL PRODUCTS -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAllProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🛍️ All Products"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- CART -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCategoryCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="🛒 Shopping Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@color/fone_yellow_dark"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
