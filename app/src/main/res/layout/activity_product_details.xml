<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/black_charcoal_hex">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintWidth_max="@dimen/content_max_width"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- PRODUCT IMAGE -->

            <ImageView
                android:id="@+id/imgProductDetails"
                android:layout_width="match_parent"
                android:layout_height="@dimen/product_detail_image_height"
                android:scaleType="fitCenter"
                android:padding="16dp"
                android:background="#F5F5F5"
                android:importantForAccessibility="no" />

            <!-- CATEGORY -->

            <TextView
                android:id="@+id/txtProductCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="16sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="24dp" />

            <!-- PRODUCT NAME -->

            <TextView
                android:id="@+id/txtProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Name"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp" />

            <!-- PRICE -->

            <TextView
                android:id="@+id/txtProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="K0.00"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/fone_yellow_text"
                android:layout_marginTop="12dp" />

            <!-- DESCRIPTION -->

            <TextView
                android:id="@+id/txtProductDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product description"
                android:textSize="@dimen/body_text_size"
                android:textColor="@color/text_primary"
                android:layout_marginTop="16dp" />

            <!-- ADD TO CART -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="Add to Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="30dp"
                app:backgroundTint="@color/fone_yellow"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

            <!-- VIEW CART -->

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailsCart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/button_height"
                android:text="View Shopping Cart"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                app:backgroundTint="@color/fone_yellow_dark"
                app:strokeWidth="0dp"
                app:cornerRadius="@dimen/button_corner_radius" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
